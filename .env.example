# Host interface. Keep loopback unless an authenticated TLS reverse proxy protects the service.
TWITCH_DROPS_BIND=127.0.0.1

# Host-side port. The container always listens on 8080.
TWITCH_DROPS_PORT=8080

# The root JVM listener is loopback-only by default. Compose explicitly overrides this to 0.0.0.0
# inside the container while keeping the host publication above loopback-only.
# TWITCH_DROPS_LISTEN_HOST=127.0.0.1

# Reverse proxy only: comma-separated Host authorities and browser origins accepted by the app.
# Do not add public names unless an authenticated TLS reverse proxy protects them. Forwarded headers
# are never trusted. Keep loopback hosts for the container health check. The Compose defaults accept
# loopback browser origins on any host-published port; use exact HTTPS origins for proxy deployments.
# TWITCH_DROPS_TRUSTED_HOSTS=127.0.0.1,localhost,[::1],drops.example.com
# TWITCH_DROPS_TRUSTED_ORIGINS=https://drops.example.com

# Optional: override the small-service JVM profile for unusually large inventories.
# TWITCH_DROPS_JAVA_OPTS=-Xms16m -Xmx256m -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=32m -XX:MaxDirectMemorySize=32m -Dfile.encoding=UTF-8

# Optional: provide through a secret manager, not a committed .env file.
# Must be a base64-encoded 32-byte key.
# TWITCH_DROPS_SESSION_KEY=
